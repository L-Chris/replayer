# Copy to .env. Never commit the real key.
LLM_API_KEY=
LLM_BASE_URL=https://chat.rethinkos.com/v1
LLM_MODEL=qwen/omni-flash
# auto: data_url for Qwen, standard base64 for other models.
LLM_AUDIO_ENCODING=auto
# Audio file format: mp3 (default, 64 kbps mono) or wav.
LLM_AUDIO_FORMAT=mp3
# Each request uploads at most this many seconds of audio (5..120).
LLM_SUBTITLE_CHUNK_SECONDS=120
# false: target language only; true: original + target language.
LLM_SUBTITLE_BILINGUAL=false
# default omits reasoning_effort; other levels depend on model support.
LLM_REASONING_EFFORT=default
